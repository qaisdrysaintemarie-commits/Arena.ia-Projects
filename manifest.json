{
  "manifest_version": 3,
  "name": "Arena.ai Conversation Folders",
  "version": "1.0.0",
  "description": "Organisez vos conversations Arena.ai avec des dossiers directement dans l'interface",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.arena.ai/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.arena.ai/*"],
      "js": ["utils/storage.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}